# Static analysis of the game (bin/jumphp test <game> runs it when the engine dev tools are installed:
# bin/jumphp test engine once). Level 5: wrong types, unknown methods, missing arguments.
parameters:
    level: 5
    paths: [src]
    scanFiles: [../../engine/stubs/sdl.stub.php, ../../engine/stubs/async.stub.php, ../../engine/stubs/opengl.stub.php, ../../engine/stubs/openal.stub.php]
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - identifier: trait.unused
        # SDL / TTF stubs type resources as never null, and the protocol's fiber loops forever on purpose
        - identifier: if.alwaysTrue
          path: src/Gui/MonoFont.php
        - identifier: ternary.alwaysTrue
          path: src/Gui/MonoFont.php
        - identifier: booleanNot.alwaysFalse
          path: src/Gui/MonoFont.php
        - identifier: while.alwaysTrue
          path: src/Db/MysqlConnection.php
        - identifier: booleanNot.alwaysTrue
          path: src/Db/MysqlConnection.php
